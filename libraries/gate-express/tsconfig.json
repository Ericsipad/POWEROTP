{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "ES2022"],
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
